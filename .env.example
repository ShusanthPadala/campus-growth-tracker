# All variables below are SERVER-ONLY: none is prefixed NEXT_PUBLIC_, so none is ever sent to a browser.
# Supabase → Project Settings → API (or "API Keys"):
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The *anon / publishable* key ONLY. NEVER put the service_role / secret key anywhere in this app.
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# ── Rate-limit salt (required) ──────────────────────────────────────────────
# Random string used to hash visitor IPs for rate limiting. Generate with:  openssl rand -hex 32
IP_HASH_SALT=change-me-to-a-long-random-string

# ── Optional ────────────────────────────────────────────────────────────────
# Your deployed URL, used in referral links (falls back to the request host).
SITE_URL=https://your-app.vercel.app
# Set to "false" to hide the public /demo dashboard (fictional data only).
ENABLE_PUBLIC_DEMO=true
